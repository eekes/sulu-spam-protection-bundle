<?xml version="1.0" ?>
<!--
    The properties an editor fills in when they add the spam protection field to a form. Sulu does
    not translate form field metadata, so everything here is literal text. Copy this file into the
    project and point eekes_sulu_spam_protection.field_xml_path at it to change the wording or the
    language.
-->
<properties xmlns="http://schemas.sulu.io/template/template"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/properties-1.0.xsd">
    <property name="title" type="text_line" mandatory="true">
        <meta>
            <title>Title</title>
            <info_text>Internal name of the field. Visitors never see it: it checks every submission for spam invisibly.</info_text>
        </meta>
    </property>
</properties>
