<?xml version="1.0" ?>
<!--
    The properties an editor fills in when they add the spam protection field to a form. Titles
    without a lang attribute are translation keys, which Sulu translates in the admin domain for
    every admin locale. Copy this file into the project and point
    eekes_sulu_spam_protection.field_xml_path at it to change more than the wording.
-->
<properties xmlns="http://schemas.sulu.io/template/template"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/properties-1.0.xsd">
    <property name="title" type="text_line" mandatory="true">
        <meta>
            <title>eekes_spam_protection.field.title</title>
            <info_text>eekes_spam_protection.field.title_info</info_text>
        </meta>
    </property>
</properties>
